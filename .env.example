# Optional: enables the contact form to actually deliver emails.
# Sign up at https://resend.com, verify a domain (or use their test sender),
# and paste the API key here.
RESEND_API_KEY=

# The inbox that should receive contact form submissions.
CONTACT_TO_EMAIL=akarshaagarwal25@gmail.com

# Optional: a verified "from" address for Resend. Defaults to Resend's
# shared test sender if not set (fine for getting started, not for production).
CONTACT_FROM_EMAIL=

# Optional: raises GitHub API rate limits for the /api/github route.
# A classic personal access token with no scopes is enough.
GITHUB_TOKEN=
